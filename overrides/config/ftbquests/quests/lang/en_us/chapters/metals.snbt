	quest.09D3DEB31434C891.quest_desc: [
		"Used in electronics and a few magic recipes."
		""
		"§e§lHow to complete:§r Find, mine or loot Silver Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.09D3DEB31434C891.title: "Silver"
	quest.10A31BC3B6815F87.quest_desc: [
		"A strange dark dimension with Allthemodium and some mean mobs."
		""
		"§e§lHow to complete:§r Travel to the Other. The quest completes on its own as soon as you do it. §7(Optional: you can skip this one.)§r"
	]
	quest.10A31BC3B6815F87.title: "The Other"
	quest.11E4CC90A097EA92.quest_desc: [
		"Travel to the Mining dimension, a flat world made for strip mining."
		""
		"§e§lHow to complete:§r Craft or make Teleport Pad and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.11E4CC90A097EA92.title: "Teleport Pad"
