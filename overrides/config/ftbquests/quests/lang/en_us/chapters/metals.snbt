	quest.13B2B4C5863B64AA.quest_desc: [
		"All the Ores adds tin, lead, silver, nickel, osmium, zinc and more. Every tech mod shares the same ores, so one mine feeds them all."
		""
		"§e§lHow to complete:§r Find, mine or loot Tin Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.13B2B4C5863B64AA.title: "Extra Ores"
