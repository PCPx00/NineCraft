	quest.2DBB9D9CDE331BD6.title: "Unobtainium"
	quest.38FFAEFB4C72AB05.quest_desc: [
		"An empty void dimension. A blank canvas for huge builds."
		""
		"§e§lHow to complete:§r Travel to the Beyond. The quest completes on its own as soon as you do it. §7(Optional: you can skip this one.)§r"
	]
	quest.38FFAEFB4C72AB05.title: "The Beyond"
	quest.3D2304D6DCA49438.quest_desc: [
		"Allthemodium, Vibranium and Unobtainium are the strongest metals in the pack. Each lives in a different dimension and needs a stronger pickaxe than the last."
		""
		"§eThe path:§r netherite pickaxe, then Allthemodium (Overworld, deep), Vibranium (Nether) and Unobtainium (End). Along the way, the extra ores from All the Ores fuel every tech mod. Start with some raw iron."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Raw Iron and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.3D2304D6DCA49438.title: "Deep Metals"
