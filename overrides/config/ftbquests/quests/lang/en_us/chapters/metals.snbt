	quest.212F4719C0477B40.quest_desc: [
		"Allthemodium ore generates deep underground, often near ancient cities and in the Mining dimension. It shows up as a glowing yellow ore."
		""
		"§eTip:§r mine it with a netherite pickaxe, then process it in your best ore line."
		""
		"§e§lHow to complete:§r Find, mine or loot Allthemodium Ore and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.212F4719C0477B40.title: "Allthemodium Ore"
	quest.2DBB9D9CDE331BD6.quest_desc: [
		"Unobtainium ore is found in the End. You need a Vibranium pickaxe to mine it."
		""
