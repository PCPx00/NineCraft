	quest.03CDC222DC26F601.title: "Nether Prediction"
	quest.112E0C9F4CFA7882.quest_desc: [
		"A data center, a fabricator and a row of chambers. Every mob is at your fingertips."
		""
		"§e§lHow to complete:§r Craft or make Data Center, Loot Fabricator and 4 x Simulation Chamber and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.112E0C9F4CFA7882.title: "Network Master"
	quest.11343448301F756D.quest_desc: [
		"A pristine prediction from overworld mobs."
		""
		"§e§lHow to complete:§r Find, mine or loot Generalized Overworld Prediction and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.11343448301F756D.title: "Overworld Prediction"
	quest.11E756BF1DF39A16.quest_desc: [
		"§eHow the simulation chamber works:§r put a data model in the top slot and prediction matrices in the input. Give it power and it produces predictions. Higher-tier models (Basic, Advanced, Superior, Self-Aware) make predictions more reliably."
		""
		"§e§lHow to complete:§r Craft or make Simulation Chamber and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.11E756BF1DF39A16.title: "Simulation Chamber"
	quest.1303C3AA73F978D2.quest_desc: [
		"Blaze models make blaze rods forever."
		""
		"§e§lHow to complete:§r Kill 10 x Blaze. The quest completes on its own as soon as you do it."
	]
	quest.1303C3AA73F978D2.title: "Blaze Model"
