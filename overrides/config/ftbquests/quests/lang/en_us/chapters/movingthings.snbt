{
	quest.11A121B35FEFA53C.quest_desc: [
		"Pulls items out of the inventory the router faces."
		""
		"§e§lHow to complete:§r Craft or make Puller Module Mk1 and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.11A121B35FEFA53C.title: "Pull Items"
	quest.11A261D921225BE4.quest_desc: [
		"§eHow LaserIO works:§r place Laser Nodes on blocks you want to connect. Link nodes with the Laser Wrench. Then put cards in each node's side slots: an extractor card where items come from, an inserter card where they go."
		""
		"§e§lHow to complete:§r Craft or make Laser Node and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.11A261D921225BE4.title: "LaserIO"
