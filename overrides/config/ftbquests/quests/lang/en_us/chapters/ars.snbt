	quest.187178130DBD1E77.quest_desc: [
		"Ars Nouveau lets you build your own spells out of glyphs: a §eForm§r (how it's cast), §eEffects§r (what it does) and §eAugments§r (tweaks like more power or area)."
		""
		"§eThe path:§r get your first spellbook, make source gems, build a Scribe's Table to craft glyphs, then level up to Apprentice and Archmage books. Grab some amethyst first."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Amethyst Shard and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.187178130DBD1E77.title: "Build Your Own Spells"
