	quest.0EED97B084AF9ED6.quest_desc: [
		"§dNine Craft Quest Book§r"
		""
		"Every quest, description, chapter layout and piece of chapter art in this book was written and drawn for the §5Nine Craft§r modpack."
		""
		"Copyright (c) 2026 Nine Craft. All Rights Reserved."
		""
		"You may play with, edit and share this book as part of Nine Craft. Please do not copy it into other public modpacks without written permission from the Nine Craft team."
		""
		"§8This quest is hidden and only appears in edit mode.§r"
	]
	quest.0EED97B084AF9ED6.quest_subtitle: "Copyright (c) 2026 Nine Craft"
	quest.0EED97B084AF9ED6.title: "§5Nine Craft§r - Quest Book Notice"
	quest.10EBC77A32BDECC6.quest_desc: [
		"Oritech is a sleek tech mod with a strong focus on machines you upgrade by placing addon blocks next to them."
		""
		"§eThe path:§r a simple generator, then the pulverizer and assembler, then the foundry for alloys. Machine cores let you build bigger multiblocks, and it all ends with the reactor."
		""
		"Get some copper ready."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Copper Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.10EBC77A32BDECC6.title: "Futuristic Industry"
	quest.10F38F57CBA99645.quest_desc: [
		"A late-game component."
		""
		"§e§lHow to complete:§r Craft or make Super AI Chip and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.10F38F57CBA99645.title: "Super AI Chip"
	quest.11E76F971A4FF87E.quest_desc: [
		"Reactor online, AI chips in hand and a stack of prometheum. You've conquered Oritech."
		""
		"§e§lHow to complete:§r Craft or make Nuclear Reactor Controller, Super AI Chip and 8 x Prometheum and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
