	quest.60955EB9843A7BE1.title: "Lasers"
	quest.6E324F8254AF67FB.quest_desc: [
		"Charge the Laser Amplifier to at least 1 GJ, put a filled Hohlraum in the controller, then pulse the amplifier with redstone. If the reactor starts, keep deuterium and tritium flowing!"
