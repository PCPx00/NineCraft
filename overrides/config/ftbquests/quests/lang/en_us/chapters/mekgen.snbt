{
	quest.01CB90EF050B5B9B.quest_desc: [
		"Tritium gas is made from lithium in the Solar Neutron Activator. Keep it in a chemical tank for the reactor."
		""
		"§e§lHow to complete:§r Craft or make Solar Neutron Activator and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.01CB90EF050B5B9B.title: "Tritium"
	quest.054A804E7F67242E.quest_desc: [
		"A lit fusion reactor, a spinning turbine and a solar field. Mekanism's power problems are solved for good."
		""
