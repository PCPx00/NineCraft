{
	quest.10611044EA9A6FDA.quest_desc: [
		"Productive Bees adds hundreds of bees that make combs full of ores, gems and more."
		""
		"§eThe path:§r catch bees from nests, house them in hives, spin their combs in a centrifuge, then breed new species. It ends with automated breeding, genes and tons of resource combs. Grab a few honeycombs first."
		""
		"§e§lHow to complete:§r Find, mine or loot 3 x Honeycomb and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.10611044EA9A6FDA.title: "Resource Bees"
	quest.117C9E5B75E463D9.quest_desc: [
		"Keeps bees near their flowers so they work faster."
		""
		"§e§lHow to complete:§r Craft or make Feeding Slab and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
