	quest.4C1F13F7933580E0.title: "Turbine Power Tap"
	quest.52CC2C8F9906EC76.quest_desc: [
		"A passive reactor sends power straight out of the Power Tap. It's easy and safe. Once it's running, check the controller GUI to watch fuel use and heat."
		""
		"§e§lHow to complete:§r Find, mine or loot 32 x Yellorium Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.52CC2C8F9906EC76.title: "Go Passive First"
