	quest.2054F786ADE4EB22.title: "Personal Shrinking Device"
	quest.552DA200E2DD4FD8.quest_desc: [
		"Compact Machines puts a whole room inside a single block, so you can hide a big factory in a tiny space."
		""
		"§eHow:§r craft a Compact Machine, place it, and right-click it with a Personal Shrinking Device to go inside. Items, fluids and power go in through tunnels on the walls. Grab a couple of ender pearls first."
		""
		"§e§lHow to complete:§r Find, mine or loot 2 x Ender Pearl and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.552DA200E2DD4FD8.title: "Bigger on the Inside"
