	quest.24EEC9A4CF00A41E.quest_desc: [
		"A Wraithbound card with netherite scrap and echo shards (or Grim Soul Speed Cards). 5,120 items a second and over 4 million FE a tick: the top tier."
		""
		"§e§lHow to complete:§r Craft or make Soulforged Pipe Upgrade and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.24EEC9A4CF00A41E.title: "Soulforged Pipe Upgrade"
	quest.29B845CD7BCC3E77.quest_desc: [
		"Build a line that sorts: one Input end pulls from a storage chest, and each Output end has a whitelist filter (ores into one chest, food into another). Give the leftover chest the lowest priority."
		""
		"§e§lHow to complete:§r Craft or make 16 x Reaper Item Pipe and 4 x Chest and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.29B845CD7BCC3E77.title: "Sorting Wall"
	quest.2BDBC1FC875E40E1.quest_desc: [
		"The same recipe with an osmium ingot in the middle. Moves Mekanism gases, infuse types, pigments and slurries."
		""
		"§eTip:§r like Mekanism's own tubes, set the machine's side configuration to Output on the side you pull from."
		""
		"§e§lHow to complete:§r Craft or make 8 x Reaper Chemical Pipe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.2BDBC1FC875E40E1.title: "Reaper Chemical Pipe"
	quest.4FA01EA1D3D27852.quest_desc: [
		"The same recipe with a block of redstone in the middle. Moves Forge Energy from any generator or battery."
		""
		"§e§lHow to complete:§r Craft or make 8 x Reaper Energy Pipe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.4FA01EA1D3D27852.title: "Reaper Energy Pipe"
	quest.5BB130FB187103CC.quest_desc: [
		"A Whispering card with diamonds and amethyst. 128 items a second and 1,600 mB of fluid a tick."
		""
		"§e§lHow to complete:§r Craft or make Restless Pipe Upgrade and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.5BB130FB187103CC.title: "Restless Pipe Upgrade"
	quest.5BF41E41E7E6E436.quest_desc: [
		"Polished deepslate, amethyst and a hopper. Moves items from any inventory: chests, machines, AE2, Refined Storage and more."
		""
		"§eTry it:§r run a pipe from a chest to a furnace and set the chest end to Input with the wrench. Items arrive instantly, with nothing flying around inside the pipe."
		""
		"§e§lHow to complete:§r Craft or make 8 x Reaper Item Pipe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.5BF41E41E7E6E436.title: "Reaper Item Pipe"
}
