{
	quest.0A508C42B8B43334.quest_desc: [
		"Needed to mine Vibranium. See the §5Deep Metals§r chapter."
		""
		"§e§lHow to complete:§r Craft or make Allthemodium Pickaxe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.0A508C42B8B43334.title: "Allthemodium Pickaxe"
	quest.0BC42FFF6AB1F620.quest_desc: [
		"§dNine Craft Quest Book§r"
		""
		"Every quest, description, chapter layout and piece of chapter art in this book was written and drawn for the §5Nine Craft§r modpack."
		""
		"Copyright (c) 2026 Nine Craft. All Rights Reserved."
		""
		"You may play with, edit and share this book as part of Nine Craft. Please do not copy it into other public modpacks without written permission from the Nine Craft team."
		""
		"§8This quest is hidden and only appears in edit mode.§r"
	]
	quest.0BC42FFF6AB1F620.quest_subtitle: "Copyright (c) 2026 Nine Craft"
	quest.0BC42FFF6AB1F620.title: "§5Nine Craft§r - Quest Book Notice"
	quest.10C7C82B8A6A580D.quest_desc: [
		"Iron ore is common in caves between layers 0 and 60. Mine it with a stone pickaxe or better, then smelt the raw iron in a furnace."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Iron Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.10C7C82B8A6A580D.title: "Iron Age"
	quest.1243DC558461A592.quest_desc: [
		"The rarest of the three metals, hidden in the End."
		""
		"§e§lHow to complete:§r Find, mine or loot Unobtainium Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1243DC558461A592.title: "Unobtainium"
	quest.127F5303580A5B8D.quest_desc: [
		"Let your network craft for you."
		""
		"§e§lHow to complete:§r Craft or make Molecular Assembler and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.127F5303580A5B8D.title: "Autocrafting"
	quest.132B3C548061E06C.quest_desc: [
		"Cataclysm adds much tougher bosses with great loot. Check the §5Cataclysm§r chapter once you have good gear."
		""
		"§e§lHow to complete:§r Kill Ender Guardian. The quest completes on its own as soon as you do it. §7(Optional: you can skip this one.)§r"
	]
	quest.132B3C548061E06C.title: "Bigger Bosses"
	quest.13F758BCFBD1BEDC.quest_desc: [
		"Nether fortresses are made of nether brick. Blazes and wither skeletons live there."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Nether Brick and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.13F758BCFBD1BEDC.title: "Find a Fortress"
	quest.142E62AF28BF4BD6.quest_desc: [
		"A Nether Star makes a beacon. Put it on a pyramid of metal blocks for powerful buffs."
		""
		"§e§lHow to complete:§r Craft or make Beacon and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.142E62AF28BF4BD6.title: "Beacon"
	quest.146C84179E891B8E.quest_desc: [
		"Blaze powder and ender pearls make these. Throw them to find a stronghold."
		""
		"§e§lHow to complete:§r Craft or make 12 x Eye of Ender and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.146C84179E891B8E.title: "Eyes of Ender"
	quest.14C89FD39364A2D2.quest_desc: [
		"Water and lava in a bucket solve a lot of early problems."
		""
		"§e§lHow to complete:§r Craft or make Bucket and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.14C89FD39364A2D2.title: "Carry Liquids"
	quest.151D822650CFEFAD.quest_desc: [
		"Coal and sticks make torches. Light up caves as you explore."
		""
		"§e§lHow to complete:§r Craft or make 32 x Torch and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.151D822650CFEFAD.title: "Torches"
	quest.162CB85D5ED5F7F3.quest_desc: [
		"Iron Furnaces are quicker than vanilla and can be upgraded in place. Check the §5Getting Equipped§r chapter for more."
		""
		"§e§lHow to complete:§r Craft or make Iron Furnace and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.162CB85D5ED5F7F3.title: "A Faster Furnace"
	quest.169D23366DD25DDD.quest_desc: [
		"Infinity tools, MekaSuits and Quantum armor are the reward for a big factory."
		""
		"§e§lHow to complete:§r Craft or make Infinity Drill and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.169D23366DD25DDD.title: "Endgame Toys"
	quest.1824E50D12C3457A.quest_desc: [
		"The deepest ore in the pack. Look for it in ancient cities and deep caves, and mine it with a netherite pickaxe."
		""
		"§e§lHow to complete:§r Find, mine or loot Allthemodium Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1824E50D12C3457A.title: "Allthemodium"
	quest.186A326609A2579F.quest_desc: [
		"A box that keeps its items when broken."
		""
		"§e§lHow to complete:§r Craft or make Shulker Box and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.186A326609A2579F.title: "Shulker Box"
	quest.1919B363284C3426.quest_desc: [
		"Just enough to break stone."
		""
		"§e§lHow to complete:§r Craft or make Wooden Pickaxe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1919B363284C3426.title: "First Pickaxe"
	quest.1959FC8F3E4E42DA.quest_desc: [
		"Ancient debris hides deep in the Nether, around layer 15. Smelt it into scrap, then combine four scraps with four gold."
		""
		"§e§lHow to complete:§r Craft or make Netherite Ingot and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1959FC8F3E4E42DA.title: "Netherite"
	quest.19B76BB001BAF4A7.quest_desc: [
		"Mystical Agriculture lets you farm iron, diamonds and more."
		""
		"§e§lHow to complete:§r Craft or make Inferium Seeds and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.19B76BB001BAF4A7.title: "Grow Resources"
	quest.1A2819C537D00BD1.quest_desc: [
		"A furnace smelts ores and cooks food. You will build a lot of these."
		""
		"§e§lHow to complete:§r Craft or make Furnace and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1A2819C537D00BD1.title: "Fire It Up"
	quest.1A33B366F97A30F8.quest_desc: [
		"A key part of many high-end recipes. Once you can farm the Wither, you'll never run short."
		""
		"§e§lHow to complete:§r Find, mine or loot Nether Star and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1A33B366F97A30F8.title: "Nether Star"
	quest.1B60B553C5F3BC2C.quest_desc: [
		"Till dirt with a hoe near water and plant seeds. Wheat makes bread."
		""
		"§e§lHow to complete:§r Find, mine or loot 32 x Wheat Crops and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1B60B553C5F3BC2C.title: "Start a Farm"
	quest.1B92EC71741B2107.quest_desc: [
		"Quantum armor is one of the last things you can make in Nine Craft. Good luck!"
		""
		"§e§lHow to complete:§r Craft or make Quantum Helmet and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1B92EC71741B2107.title: "The Very End"
	quest.1BAA332490C3296A.quest_desc: [
		"A proper storage network changes everything. Autocrafting, remote access, no more sorting."
		""
		"§e§lHow to complete:§r Craft or make ME Controller and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1BAA332490C3296A.title: "A Storage Network"
	quest.1C40393207359026.quest_desc: [
		"Fill the portal frame and jump in."
		""
		"§e§lHow to complete:§r Travel to the End. The quest completes on its own as soon as you do it."
	]
	quest.1C40393207359026.title: "Enter the End"
	quest.1C5C2E8C2171A5A9.quest_desc: [
		"Organize early with drawers or a Tom's Simple Storage terminal, then graduate to AE2 or Refined Storage."
		""
		"§e§lHow to complete:§r Craft or make 8 x Chest and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1C5C2E8C2171A5A9.title: "Too Many Chests"
	quest.1CBEFF63345BCAB7.quest_desc: [
		"Farm some wheat or cook meat. Farmer's Delight and HarvestCraft add plenty of better meals later."
		""
		"§e§lHow to complete:§r Find, mine or loot Bread and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1CBEFF63345BCAB7.title: "Don't Go Hungry"
	quest.1CDEC025069D527A.quest_desc: [
		"Turn logs into planks in your inventory crafting grid, then put four planks in a square to make a crafting table. Place it and right-click to use the full 3x3 grid."
		""
		"§e§lHow to complete:§r Craft or make Crafting Table and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1CDEC025069D527A.title: "A Place to Craft"
	quest.1D3072D14DB4DDFD.quest_desc: [
		"Classic Minecraft is beaten, but Nine Craft is just getting started."
		""
		"§e§lHow to complete:§r Kill Ender Dragon. The quest completes on its own as soon as you do it."
	]
	quest.1D3072D14DB4DDFD.title: "Slay the Dragon"
	quest.1DDA16367FBB23DF.quest_desc: [
		"Needed to mine diamonds, gold and redstone."
		""
		"§e§lHow to complete:§r Craft or make Iron Pickaxe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1DDA16367FBB23DF.title: "Iron Pickaxe"
	quest.1DE0135F626E9D23.quest_desc: [
		"Deepslate levels are where diamonds hide. Five is enough for a pick and more."
		""
		"§e§lHow to complete:§r Find, mine or loot 5 x Diamond and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1DE0135F626E9D23.title: "Diamonds!"
	quest.1ECC405D618DD132.quest_desc: [
		"Ars Nouveau, Iron's Spells 'n Spellbooks and Occultism all live in the §5Magic§r group. Try one!"
		""
		"§e§lHow to complete:§r Craft or make Novice Spell Book and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.1ECC405D618DD132.title: "A Little Magic"
	quest.1F661EC79B52AD20.quest_desc: [
		"Suit up before exploring deeper caves."
		""
		"§e§lHow to complete:§r Craft or make Iron Chestplate and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1F661EC79B52AD20.title: "Iron Armor"
	quest.1FE56DCBF5E6E930.quest_desc: [
		"Wither skeletons in fortresses sometimes drop their skulls. A Looting sword helps a lot."
		""
		"§e§lHow to complete:§r Find, mine or loot 3 x Wither Skeleton Skull and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.1FE56DCBF5E6E930.title: "Wither Skulls"
	quest.2A0988BA322EE7E5.quest_desc: [
		"Productive Bees makes combs full of resources."
		""
		"§e§lHow to complete:§r Craft or make Bee Cage and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.2A0988BA322EE7E5.title: "Resource Bees"
	quest.2A288B1E33D5FDBB.quest_desc: [
		"Tougher than Allthemodium, found in the Nether's depths."
		""
		"§e§lHow to complete:§r Find, mine or loot Vibranium Ingot and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.2A288B1E33D5FDBB.title: "Vibranium"
	quest.2DE2AE6EB6B2C8F6.quest_desc: [
		"Find an End City ship to get wings!"
		""
		"§e§lHow to complete:§r Find, mine or loot Elytra and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.2DE2AE6EB6B2C8F6.title: "Elytra"
	quest.318319820AB7F305.quest_desc: [
		"Iron's Spells gives you ready-made spells to use right away."
		""
		"§e§lHow to complete:§r Craft or make Ironbound Tome and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.318319820AB7F305.title: "Another School of Magic"
	quest.335B2FD40FE15906.quest_desc: [
		"Every run starts the same way: punch some trees! Hold left-click on a log until it breaks. Collect a stack."
		""
		"§eTip:§r hold the vein-mining key to chop a whole tree at once."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Oak Log and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.335B2FD40FE15906.title: "Punch Some Trees"
	quest.3994D58B5C64161E.quest_desc: [
		"Nine Craft's own mod, Grim Soul Industries, kills mobs and collects their drops and XP for you. See the §5Grim Soul Industries§r chapter."
		""
		"§e§lHow to complete:§r Craft or make Reaper Block and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.3994D58B5C64161E.title: "Automate Mob Farming"
	quest.399A657FD12F2360.quest_desc: [
		"Upgrade to stone tools right away. They mine faster and last longer."
		""
		"§e§lHow to complete:§r Craft or make Stone Pickaxe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.399A657FD12F2360.title: "Stone Tools"
	quest.3C40FDCC5A476B6C.quest_desc: [
		"Fusion reactors, large turbines and Powah's top tiers keep a mega base running."
		""
		"§e§lHow to complete:§r Craft or make Fusion Reactor Controller and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.3C40FDCC5A476B6C.title: "Late Game Power"
	quest.3CC536DCA5FF4DA7.quest_desc: [
		"A shield stops arrows and creeper blasts. Keep one in your offhand."
		""
		"§e§lHow to complete:§r Craft or make Shield and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in. §7(Optional: you can skip this one.)§r"
	]
	quest.3CC536DCA5FF4DA7.title: "Block It"
	quest.45C8B5DA0F98F30A.quest_desc: [
		"It's time to build something that runs on energy. The §5Basic Power§r and §5Powah§r chapters are good places to start."
		""
		"§e§lHow to complete:§r Craft or make Energy Cell (Starter) and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.45C8B5DA0F98F30A.title: "Your First Power"
	quest.4FD1A5EBBDC98D41.quest_desc: [
		"Sleep in a bed to skip the night and set your spawn."
		""
		"§e§lHow to complete:§r Craft or make White Bed and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.4FD1A5EBBDC98D41.title: "Set Your Spawn"
	quest.51D89BB11AF9A349.quest_desc: [
		"Pour water on lava to make obsidian, then mine it with a diamond pickaxe."
		""
		"§e§lHow to complete:§r Find, mine or loot 10 x Obsidian and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.51D89BB11AF9A349.title: "Obsidian"
	quest.54D9211353FEB226.quest_desc: [
		"Blazes spawn in Nether fortresses. Their rods power brewing and a lot of machines."
		""
		"§e§lHow to complete:§r Find, mine or loot 6 x Blaze Rod and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.54D9211353FEB226.title: "Blaze Rods"
	quest.5ABF46448F91494E.quest_desc: [
		"Mekanism, Modern Industrialization, Industrial Foregoing, Oritech, Create... pick one to start with. You can learn the rest later."
		""
		"§e§lHow to complete:§r Craft or make Metallurgic Infuser and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.5ABF46448F91494E.title: "Pick a Tech Mod"
	quest.66AB0A76FD172F7E.quest_desc: [
		"Enchanting is much deeper here thanks to Apothic Enchanting. See the §5Enchanting§r chapter."
		""
		"§e§lHow to complete:§r Craft or make Enchanting Table and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.66AB0A76FD172F7E.title: "Enchanting"
	quest.68F9BE72B962C59B.quest_desc: [
		"Build a portal frame 4 wide and 5 tall out of obsidian (corners optional), then light it with flint and steel. Step inside and wait a moment."
		""
		"§cCareful:§r beds explode in the Nether."
		""
		"§e§lHow to complete:§r Travel to the Nether. The quest completes on its own as soon as you do it."
	]
	quest.68F9BE72B962C59B.title: "Welcome to the Nether"
	quest.6D231B9A022CC4A7.quest_desc: [
		"Start doubling ore with Mekanism's Enrichment Chamber."
		""
		"§e§lHow to complete:§r Craft or make Enrichment Chamber and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.6D231B9A022CC4A7.title: "Double Your Ore"
	quest.73FB6CCCAF0E5CB6.quest_desc: [
		"Needed to mine obsidian."
		""
		"§e§lHow to complete:§r Craft or make Diamond Pickaxe and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.73FB6CCCAF0E5CB6.title: "Diamond Pickaxe"
	quest.749AFBF02F034AC9.quest_desc: [
		"Three skulls and four soul sand. Fight it somewhere you don't mind blowing up."
		""
		"§e§lHow to complete:§r Kill Wither. The quest completes on its own as soon as you do it."
	]
	quest.749AFBF02F034AC9.title: "Face the Wither"
