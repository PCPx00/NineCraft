	quest.1B1BFCF779ADB80A.title: "Hoglins"
	quest.1B25394923760283.quest_desc: [
		"A diamond and a diamond sword. Kills count as player kills, so mobs drop full XP and player-only loot like wither skeleton skulls. It works in the Virtualization Chamber too."
