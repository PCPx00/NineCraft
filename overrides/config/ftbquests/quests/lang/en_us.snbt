	quest.1ED8E5EDC6C4109D.quest_desc: [
		"§dNine Craft Quest Book§r"
		""
		"Every quest, description, chapter layout and piece of chapter art in this book was written and drawn for the §5Nine Craft§r modpack."
		""
		"Copyright (c) 2026 Nine Craft. All Rights Reserved."
		""
		"You may play with, edit and share this book as part of Nine Craft. Please do not copy it into other public modpacks without written permission from the Nine Craft team."
