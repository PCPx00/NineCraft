	quest.22EB1F42A10865C9.title: "How This Book Works"
	quest.23605CD4BFE68AFA.quest_desc: [
		"The Endgame is the long final stretch of MI. Quantum circuits, fusion and quantum armor. Each quest here is a real project, so take your time."
		""
		"Start with a couple of processing units from the Digital Age."
		""
		"§e§lHow to complete:§r Craft or make 2 x Processing Unit and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.23605CD4BFE68AFA.title: "Quantum Leap"
