	quest.1A91EB9E62CABD35.title: "QIO Exporter"
	quest.1A92C4ED4A039DB2.quest_desc: [
		"The Leviathan lives in the Sunken City, deep in the ocean. You'll need water breathing and a way to fight underwater. She's invincible outside of water."
		""
		"§e§lHow to complete:§r Kill The Leviathan. The quest completes on its own as soon as you do it."
	]
