	quest.220885BA4BE57162.title: "Plant Valves"
	quest.223BB077BAB52743.quest_desc: [
		"Certus quartz grows from Budding Certus blocks found in meteorites. Place the budding block, wait for clusters to grow on its sides and break them when they're fully grown."
		""
		"§eTip:§r a Growth Accelerator next to the budding block speeds this up a lot."
		""
		"§e§lHow to complete:§r Find, mine or loot 16 x Certus Quartz Crystal and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.223BB077BAB52743.title: "Certus Quartz"
