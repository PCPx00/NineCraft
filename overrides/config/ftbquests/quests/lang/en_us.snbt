	file.0000000000000001.title: "Nine Craft"
	quest.005E1C58C5AEDABF.quest_desc: [
		"A plastic needed for the MekaSuit and QIO. Made from ethylene in the PRC."
		""
		"§e§lHow to complete:§r Craft or make 8 x HDPE Sheet and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.005E1C58C5AEDABF.title: "HDPE Sheets"
	quest.00645BCBB6646A00.quest_desc: [
		"A Nether alloy."
		""
		"§e§lHow to complete:§r Craft or make Crimson Steel Ingot and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.00645BCBB6646A00.title: "Crimson Steel"
	quest.00738E0B69B038A0.quest_desc: [
		"Restores health."
		""
		"§e§lHow to complete:§r Craft or make Heal Glyph and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.00738E0B69B038A0.title: "Heal"
	quest.007D39294E0B0A5F.quest_desc: [
		"Level a Soul Card bound to the Wither or the Ender Dragon to Soulforged, then forge it at the Soul Forge. In a Virtualization Chamber it halves the power cost of running a boss."
		""
		"§e§lHow to complete:§r Craft or make Boss Core Card and carry it in your inventory. Hover the item in JEI and press §eR§r to see how it is made. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.007D39294E0B0A5F.title: "Boss Core Card"
	quest.00CD96E9DA6CFAB6.quest_desc: [
		"§e§lHow to complete:§r Find, mine or loot Black Cherry and carry it in your inventory. The quest checks your inventory on its own; you can also click the task to hand items in."
	]
	quest.00CD96E9DA6CFAB6.title: "Black Cherry"
	quest.01209F6BE7124B04.quest_desc: [
		"Powah's Furnator burns anything a furnace would. Easy early power."
