	quest.1A20AE3E63A6CCAC.quest_desc: [
		"Machines are more fun when you don't have to feed them by hand. Here are a few ways to move items, fluids and energy."
	]
	quest.1A20AE3E63A6CCAC.title: "Items on the Move"
